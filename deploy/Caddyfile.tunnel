# Tunnel mode: Cloudflare terminates HTTPS and cloudflared forwards plain HTTP to this Caddy.
# cloudflared is a trusted proxy (private Docker network), so the X-Forwarded-For / -Proto it
# sets (the real visitor, https) pass through to the api.
{
	auto_https off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	handle {
		reverse_proxy web:80
	}
}
