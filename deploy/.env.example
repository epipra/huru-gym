# Copy to deploy/.env on the server. Never commit the real file.

# --- Huru GYM deployment ---
HURU_DOMAIN=gym.adxfuel.com
ACME_EMAIL=support@adxfuel.com
# Unused in tunnel mode: data lives in the huru-gym_huru_data volume.
HURU_DATA_DIR=/srv/huru-gym/data

# --- upstream openGym API settings (see ../.env.example for every option) ---
RP_ID=gym.adxfuel.com
ORIGIN=https://gym.adxfuel.com
RP_NAME=Huru GYM

# Beta access (decision D12)
# First boot: INVITE_ONLY=0, create the owner account (becomes admin), then set 1 and
# `docker compose up -d` again. With 1 even the first signup needs an invite code.
INVITE_ONLY=0
PASSWORD_LOGIN=1
ALLOW_GUEST=0
FIRST_USER_ADMIN=1
SESSION_DAYS=90

# Tunnel mode only (docker-compose.tunnel.yml): token from Cloudflare Zero Trust -> Tunnels.
# Paste it into deploy/.env yourself; it is a secret.
TUNNEL_TOKEN=

# --- Huru GYM Pro (api/huru/routes.js) ---
# 1 = the AI Coach needs Pro (admins always have it). Stripe keys come from the Stripe
# dashboard of AdxFuel LLC; never commit or paste them anywhere but this file.
HURU_BILLING=1
HURU_TRIAL_DAYS=7
# Test-mode keys and price IDs until the live switch (RUNBOOK 8 step 4).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- Consent screen (api/huru/routes.js) ---
# Bump HURU_CONSENT_VERSION when the Privacy Policy or Terms change so everyone agrees again.
# The URLs (https only) are linked beside the checkboxes once the documents are published.
HURU_CONSENT_VERSION=2026-10-12
HURU_PRIVACY_URL=https://gym.adxfuel.com/legal/privacy.html
HURU_TERMS_URL=https://gym.adxfuel.com/legal/terms.html

# E-mail for password-reset codes (api/huru/mail.js). Off until SMTP_USER and SMTP_PASS are set.
# Google Workspace: an app password of the sending mailbox (Google Account -> Security ->
# 2-Step Verification -> App passwords). Paste it here, never into chat or git.
SMTP_USER=support@adxfuel.com
SMTP_PASS=
MAIL_FROM="Huru GYM <support@adxfuel.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Encrypted daily backups to Cloudflare R2 (deploy/backup.sh, RUNBOOK section 10). Idle until set.
# R2 API token: Cloudflare (AdxFuel LLC) -> R2 -> Manage API Tokens -> Object Read & Write on
# bucket huru-gym-backups. BACKUP_PASSPHRASE encrypts the backups: keep a copy in your password
# manager, or the backups cannot be restored if this machine is lost.
R2_ENDPOINT=https://706123b2a337afe872cf289e82de2185.r2.cloudflarestorage.com
R2_BUCKET=huru-gym-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=30
