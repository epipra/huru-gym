# Copy to deploy/.env on the server. Never commit the real file.

# --- Huru GYM deployment ---
HURU_DOMAIN=gym.epipra.com
ACME_EMAIL=ops@epipra.com
HURU_DATA_DIR=/srv/huru-gym/data

# --- upstream openGym API settings (see ../.env.example for every option) ---
RP_ID=gym.epipra.com
ORIGIN=https://gym.epipra.com
RP_NAME=Huru GYM

# Beta access (decision D12)
# First boot: INVITE_ONLY=0, create the owner account (becomes admin), then set 1 and
# `docker compose up -d` again. With 1 even the first signup needs an invite code.
INVITE_ONLY=0
PASSWORD_LOGIN=1
ALLOW_GUEST=0
FIRST_USER_ADMIN=1
SESSION_DAYS=90
